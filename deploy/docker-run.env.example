# docker run 方式的环境变量示例。
# 用法：cp deploy/docker-run.env.example deploy/docker-run.env 后按需修改，
#       脚本会自动通过 --env-file 加载（文件不存在则跳过）。
# 说明：简单标量配置可用环境变量覆盖；数据源 URL/密码这类含下划线的 Map 键，
#       推荐用 config/application.yml 覆盖（见 DEPLOY.md）。

# 时区
TZ=Asia/Shanghai

# JVM 参数（覆盖镜像默认值）
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Xms512m -Xmx1024m

# 激活的 Spring Profile（连接外部 PG 时留空，用 config/application.yml 覆盖）
# SPRING_PROFILES_ACTIVE=local

# 常见可被环境变量覆盖的配置（Spring relaxed binding）
# SERVER_PORT=13607
# DATA_SYNC_MODE=db
# DATA_SYNC_BATCH_SIZE=1000
# DATA_SYNC_SCHEDULE_ENABLED=false
# DATA_SYNC_CRON=0 0 3 * * ?
